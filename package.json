{
  "name": "bot-bots",
  "version": "0.2.26",
  "private": true,
  "type": "module",
  "description": "Local-first, model-independent bot team and desktop app",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx apps/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsup && node scripts/build-speech.mjs",
    "build:speech": "node scripts/build-speech.mjs",
    "start": "node dist/server/index.js",
    "desktop": "electron .",
    "package:desktop": "node scripts/build-speech.mjs && electron-builder --dir",
    "build:launcher": "node scripts/build-launcher.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write apps packages scripts tests *.ts"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "cron-parser": "^5.4.0",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "com.botbots.desktop",
    "productName": "Bot-Bots",
    "directories": {
      "output": "release/0.2.26"
    },
    "files": [
      "dist/**/*",
      "resources/google-oauth.json",
      "resources/app-help/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/speech",
        "to": "speech",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "dist/server/**/*",
      "node_modules/@napi-rs/**/*"
    ],
    "win": {
      "icon": "resources/bot-bots.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Use the microphone you choose to turn spoken prompts into editable chat text.",
        "NSSpeechRecognitionUsageDescription": "Turn spoken prompts into editable text using macOS speech recognition."
      },
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bryancolvinfilm-bot/bot-bots.git"
  }
}
