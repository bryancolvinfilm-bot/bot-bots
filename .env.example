# Set these in the server environment before launching. This file is documentation;
# it is deliberately not automatically loaded or copied into a backup.
PORT=3210
BOT_BOTS_HOST=127.0.0.1
# BOT_BOTS_DATA_DIR=/path/to/private/team-data
# Optional legacy owner bearer token; use a random value of 24+ characters.
# BOT_BOTS_TOKEN=
# Set up owner login/pairing and a public HTTPS origin locally before web access.
# Desktop client mode starts no local host:
# BOT_BOTS_MODE=client
# BOT_BOTS_SERVER_URL=https://bots.example.com
# App-owner Google OAuth registration, applied once for browser sign-in:
# A Desktop public client ID can also ship in resources/google-oauth.json.
# Regular users do not enter API keys. Own-client import is under Advanced in Plugins.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_TYPE=desktop
# GOOGLE_REDIRECT_URI=
# Optional exact origins for desktop/mobile clients, comma separated.
# BOT_BOTS_ALLOWED_ORIGINS=http://127.0.0.1:3210,capacitor://localhost
# Optional cloud providers (no cloud provider is configured by default).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional alert API credentials; choose the env names in Settings.
# ALERT_EMAIL_TOKEN=
# ALERT_SMS_TOKEN=
